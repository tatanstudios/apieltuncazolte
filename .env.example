APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Laravel 11+ renombró CACHE_DRIVER -> CACHE_STORE y FILESYSTEM_DRIVER -> FILESYSTEM_DISK
# (los nombres antiguos siguen funcionando como respaldo en config/)
SESSION_DRIVER=file
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_ENCRYPTION ya no existe: usar MAIL_SCHEME=smtps para puerto 465 (587 usa STARTTLS automático)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Propias del proyecto
GOOGLE_API=
ONE_SIGNAL_APP_ID=
ONE_SIGNAL_AUTHORIZE=
ONE_SIGNAL_AUTH_KEY=

# OneSignal (notificaciones push). REST API Key en OneSignal > Settings > Keys & IDs
ONE_SIGNAL_APP_ID=757d1cff-cdc8-4b18-a332-e1cd7bae3eb5
ONE_SIGNAL_AUTHORIZE=
